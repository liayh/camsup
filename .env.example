# Copier en .env (à la racine du projet) puis adapter. Ce fichier contient des mots de passe : ne pas le partager.

# Compte intégrateur créé au premier démarrage seulement (base vide). Les autres comptes se gèrent dans l'interface.
ADMIN_USER=admin
ADMIN_PASSWORD=changez-moi-longtemps

# E-mail à l'installateur (enregistreur injoignable, n'enregistre plus, disque à remplacer)
# Compte d'envoi dédié conseillé (ex. Gmail avec mot de passe d'application), port 587 + STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=

# Surveillance
# RECORD_STALE_MINUTES=15    # sans nouvel enregistrement sur le NVR → alerte
# CAMERA_CHECK_SECONDS=10    # relevé du NVR (état des caméras + enregistrements)
# CAMERA_STALL_SECONDS=15    # plus d'images depuis… → caméra perdue
# NVR_FAILS=2                # relevés consécutifs en échec avant d'alerter
# HDD_CHECK_SECONDS=300
# POPUPS=1                   # fenêtre d'alerte sur ce poste
# POPUP_REMIND_HOURS=4       # fenêtre fermée → rouverte après ce délai

# Interface web (HTTPS auto-signé par défaut, certificat dans data/tls/)
# PORT=8080
# HTTPS=1
# SESSION_HOURS=12

# Clé de chiffrement des mots de passe des NVR (sinon générée dans data/secret.key — à sauvegarder !)
# SECRET_KEY=

# Extrait vidéo pour les forces de l'ordre (menu « Voir la vidéo », NVR Dahua)
# EXPORT_MAX_MINUTES=15        # durée maximale d'un extrait
# EXPORT_RETENTION_DAYS=1      # copie de travail de l'extrait effacée du PC après ce délai
# FFMPEG=ffmpeg                # chemin de ffmpeg (Windows : C:\CamSup\ffmpeg\ffmpeg.exe par exemple)
